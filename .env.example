# PostgreSQL Connection Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Schema Configuration (comma-separated list of schemas to include)
# Leave empty to include all schemas
DB_SCHEMAS=public,schema1,schema2

# Default limit for query results
DEFAULT_LIMIT=5
